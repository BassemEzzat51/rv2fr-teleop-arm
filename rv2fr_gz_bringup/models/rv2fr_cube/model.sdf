<?xml version="1.0"?>
<sdf version="1.10">
  <model name="rv2fr_cube">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <!-- Bumped from 1.0: still saw the exact symptom this comment originally
             documented (motion sequence completes, cube left behind) even at mu=1.0
             paired with the gripper's own mu=1.3 (see parallel_jaw_gripper.xacro,
             bumped to 2.5 at the same time). The finger-stop positions at grasp were
             visibly asymmetric, consistent with an off-center edge/corner graze
             rather than a full-face pinch -- that geometry needs more friction margin
             to hold than a clean center grip. See docs/decisions.md. -->
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
