<?xml version="1.0"?>
<sdf version="1.10">
  <model name="rv2fr_cylinder">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
        <!-- see rv2fr_cube/model.sdf, same friction reasoning applies. -->
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1</ambient>
          <diffuse>0.1 0.3 0.8 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
